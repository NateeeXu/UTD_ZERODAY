{
  "name": "triage-loop-spacetimedb",
  "version": "1.0.0",
  "private": true,
  "description": "Triage Loop SpacetimeDB module (HackUTD 2026). All data is synthetic.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "spacetime build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "publish:local": "spacetime publish -s local --module-path . --yes triage-loop",
    "publish:local:clean": "spacetime publish -s local --module-path . --delete-data=always --yes triage-loop",
    "generate": "spacetime generate --lang typescript --out-dir bindings --module-path . --import-extension ts",
    "seed": "node scripts/seed.ts",
    "smoke": "node scripts/smoke.ts",
    "sync-engine": "node scripts/sync-engine.ts",
    "publish:local:all": "spacetime publish -s local --module-path . --yes triage-loop && spacetime publish -s local --module-path . --yes triage-loop-tx && spacetime publish -s local --module-path . --yes triage-loop-ca",
    "seed:hb": "node scripts/seed.ts --db triage-loop --file ../data/live.json",
    "seed:tx": "node scripts/seed.ts --db triage-loop-tx --file ../data/real/tx-corpus-christi/live.json",
    "seed:ca": "node scripts/seed.ts --db triage-loop-ca --file ../data/real/ca-bay-area/live.json",
    "bench": "node scripts/bench.ts",
    "parity": "node scripts/parity.ts"
  },
  "license": "MIT",
  "dependencies": {
    "spacetimedb": "2.14.*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.6.2"
  }
}
